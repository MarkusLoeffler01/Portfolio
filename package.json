    "@mui/material": "^9.0.0",
    "@mui/system": "^9.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@types/three": "^0.184.0",
    "formik": "^2.4.9",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "react-material-ui-carousel": "^3.4.2",
